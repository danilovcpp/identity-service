# Local development only. Copy to .env and generate a random password before starting Compose.
POSTGRES_PASSWORD=
API_PORT=5080
POSTGRES_PORT=54320
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
OUTBOX_KEY_FILE=./secrets/outbox-dev.key
JWT_KEY_FILE=./secrets/jwt-dev.pem
JWT_ISSUER=https://identity.localhost
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_BATCH_SIZE=25
SESSION_CLEANUP_POLL_SECONDS=300
SESSION_CLEANUP_RETENTION_SECONDS=86400
EMAIL_VERIFICATION_URL_TEMPLATE=http://localhost:3000/verify#token={token}
# SDK/EF tooling uses an environment variable (not automatically imported from .env):
# Database__ConnectionString=Host=localhost;Port=54320;Database=identity;Username=identity;Password=<your-local-password>
