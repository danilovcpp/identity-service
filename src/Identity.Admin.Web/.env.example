# Vite server configuration only. These variables are not exposed to browser code.
IDENTITY_API_PROXY_TARGET=http://localhost:5080

# Build-time type generation only; never sent to the browser.
IDENTITY_OPENAPI_URL=http://127.0.0.1:5080/openapi/v1.json

# Optional: locally trusted PEM certificate/key files for HTTPS development.
# Both are required together; keep private keys outside the repository.
IDENTITY_DEV_HTTPS_CERT_FILE=
IDENTITY_DEV_HTTPS_KEY_FILE=
