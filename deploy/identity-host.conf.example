# Replace identity.example with your certificate's exact DNS name.
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /run/secrets/identity_tls_certificate;
    ssl_certificate_key /run/secrets/identity_tls_key;
    return 421;
}
server {
    listen 8443 ssl;
    server_name identity.example;
    include /etc/nginx/identity-server.conf;
}
