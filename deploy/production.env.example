# Copy to root .env.production (ignored). Replace placeholders through protected tooling.
# This is not used by the dev compose.yaml.
IDENTITY_IMAGE=registry.example/identity:1.0.0@sha256:<reviewed-image-digest>
API_PORT=5080
JWT_KEY_FILE=/srv/identity/secrets/jwt-2026-10.pem
OUTBOX_KEY_FILE=/srv/identity/secrets/outbox-2026-10.key
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=identity.example;localhost
IDENTITY_HEALTH_HOST=localhost
Database__ConnectionString=Host=<postgres-host>;Database=identity;Username=identity_app;Password=<from-secret-provider>;SSL Mode=VerifyFull
Registration__Enabled=true
PasswordReset__Enabled=true
Outbox__Enabled=true
Jwt__Enabled=true
Jwt__Issuer=https://identity.example
Jwt__ActiveKeyId=jwt-2026-10
Identity__Clients__0__ClientId=native
Identity__Clients__0__Audience=identity-native
Identity__Clients__0__Enabled=true
OutboxEncryption__ActiveKeyId=outbox-2026-10
OutboxEncryption__Keys__outbox-2026-10=/run/secrets/identity_outbox_key
Email__FromAddress=no-reply@identity.example
Email__VerificationUrlTemplate=https://app.example/verify#token={token}
Email__ResetPasswordUrlTemplate=https://app.example/reset#token={token}
Email__Smtp__Host=<smtp-host>
Email__Smtp__Port=587
Email__Smtp__Tls=StartTls
Email__Smtp__UserName=<from-secret-provider>
Email__Smtp__Password=<from-secret-provider>
TransportSecurity__ForwardedHeadersEnabled=true
TransportSecurity__KnownProxies__0=<exact-proxy-ip-as-seen-by-api>
TransportSecurity__ForwardLimit=1
AuthRateLimits__IpPermitLimit=30
AuthRateLimits__AccountPermitLimit=3
AuthRateLimits__WindowSeconds=60
SecurityMaintenance__Enabled=true
SecurityMaintenance__AuditRetentionDays=90
SessionCleanup__Enabled=true
# Admin API remains disabled until restricted HTTPS ingress and a durable writable key ring are provisioned.
AdminAccess__Enabled=false
# Mount the directory persistently, writable only by the non-root API identity, before enabling.
# AdminAccess__DataProtectionKeyPath=/var/lib/identity/data-protection-keys
# AdminAccess__IdleTimeoutSeconds=1800
# AdminAccess__AbsoluteLifetimeSeconds=28800
